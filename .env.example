# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/hscodematch

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Token signing secret for admin and visitor sessions (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
USER_JWT_EXPIRES_IN=7d

# Public website URL (used in password-reset emails)
SITE_URL=http://localhost:3000

# Refresh the website as soon as content is edited in the admin panel.
# Use the same secret as REVALIDATE_SECRET on the website (generate like JWT_SECRET).
REVALIDATE_URL=http://localhost:3000/api/revalidate/
REVALIDATE_SECRET=

# First admin account, used by `npm run create-admin`
ADMIN_EMAIL=admin@hscodematch.com
ADMIN_PASSWORD=change-me-strong-password

# Optional e-mail notifications for new contact messages and inquiries.
# Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HSCodeMatch <no-reply@hscodematch.com>"
NOTIFY_EMAIL=contact@hscodematch.com

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
